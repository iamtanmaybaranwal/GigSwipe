# ─────────────────────────────────────────────────────────────────────────────
# GigSwipe app configuration. Copy this file to `.env` and fill it in.
# After changing .env:  npm run start:clean   (Metro caches these values)
# and rebuild the app if you changed MAPS_API_KEY:  npm run android
# ─────────────────────────────────────────────────────────────────────────────

# Backend used by DEBUG builds. With USB debugging, `npm run android` runs
# `adb reverse tcp:3001 tcp:3001`, so the phone can reach your PC's backend
# at localhost — no Wi-Fi IP needed.
API_URL=http://localhost:3001

# Backend used by RELEASE builds (Play Store). Must be HTTPS.
API_URL_PRODUCTION=https://api.your-domain.com

# Google Maps SDK for Android key (Google Cloud Console → APIs & Services).
# Leave empty to run without the map screen (a placeholder is shown instead).
MAPS_API_KEY=
