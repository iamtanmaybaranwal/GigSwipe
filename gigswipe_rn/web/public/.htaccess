# GigSwipe web app — Apache / Hostinger settings.
# Upload this file together with everything else in web/dist.

# Always use HTTPS (needed for location, installing the app, and the service worker)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Single-page app: unknown paths load the app
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/ttf .ttf
</IfModule>

<IfModule mod_headers.c>
  # The service worker and the page itself must never be cached, so updates arrive at once
  <FilesMatch "^(sw\.js|registerSW\.js|index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Built files have a content hash in their name: cache them for a year
  <FilesMatch "\.(js|css|ttf|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
