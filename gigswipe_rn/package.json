{
  "name": "gigswipe-rn",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "android": "node scripts/rn.js run-android",
    "android:release": "node scripts/rn.js run-android --mode release",
    "start": "node scripts/rn.js start",
    "start:clean": "node scripts/rn.js start --reset-cache",
    "reverse": "node scripts/rn.js reverse",
    "build:apk": "cd android && gradlew assembleRelease",
    "build:aab": "cd android && gradlew bundleRelease",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "preview:web": "vite preview --config web/vite.config.ts",
    "images:web": "node web/scripts/make-images.mjs",
    "typecheck:web": "tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@react-native-community/geolocation": "3.4.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-vector-icons/ionicons": "14.0.0",
    "@react-navigation/bottom-tabs": "7.22.0",
    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.21.1",
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-image-picker": "8.3.0",
    "react-native-keychain": "11.0.0",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "react-native-webview": "14.0.1",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/jest": "^29.5.13",
    "@types/leaflet": "1.9.23",
    "@types/react": "^19.2.0",
    "@types/react-dom": "19.3.0",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-dotenv": "3.4.11",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3",
    "vite": "7.3.8",
    "vite-plugin-pwa": "2.0.0"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "GigSwipeSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.gigswipe.app.specs"
    }
  }
}
