# Copy to .env and fill in. Never commit .env.

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gigswipe

# Long random secret for signing login tokens (at least 32 characters).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API listens on
PORT=3001

# Optional: Google Geocoding API key for turning GPS into area names ("Seattle, WA").
# Without it, free OpenStreetMap lookups are used (fine for testing, low volume only).
GOOGLE_GEOCODING_API_KEY=

# Optional: set to 1 when running behind a proxy/load balancer (Render, Railway, Nginx)
TRUST_PROXY=
